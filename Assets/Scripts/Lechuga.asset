  m_Script: {fileID: 11500000, guid: 77b8697420a93d24297602abe3dc12d7, type: 3}
  m_Name: Lechuga
  m_EditorClassIdentifier: Assembly-CSharp::Almanaque
  img: {fileID: 7913358515664758786, guid: a778919c56225c44e94c7ab6d4d2ff8d, type: 3}
  nombre: Lechuga
  desc: "Es una hortaliza de hoja rica en agua, fibra, vitaminas A, C y K, adem\xE1s
    de \xE1cido f\xF3lico y minerales como potasio y calcio. Ayuda a la hidrataci\xF3n,
    favorece la digesti\xF3n y tiene un efecto calmante y ligeramente diur\xE9tico.
    Su consumo es com\xFAn fresca en ensaladas, s\xE1ndwiches y como base de platos
    ligeros. "
  altura: 0,25 mts.
  cuidados: "Prefiere climas frescos y suelos h\xFAmedos, ricos en materia org\xE1nica
    y bien drenados. Necesita riego regular y constante para evitar que las hojas
    se vuelvan amargas, pero sin encharcar. Se desarrolla mejor en semisombra o sol
    suave, ya que el calor intenso provoca que florezca prematuramente y pierda sabor."
